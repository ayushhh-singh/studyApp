# Server
PORT=4000
NODE_ENV=development

# CORS allowlist for the deployed web origin(s), comma-separated (localhost:3000
# is auto-allowed whenever NODE_ENV isn't "production", so dev never needs it
# listed here). e.g. ALLOWED_ORIGINS=https://neevstudy.com,https://www.neevstudy.com
ALLOWED_ORIGINS=
# Optional: allow any origin ENDING in one of these suffixes, comma-separated
# — e.g. Cloudflare Pages' per-branch preview deploys (a different exact
# origin every build) if you point previews at this same API. MUST be scoped
# to your own project (".<project-name>.pages.dev"), NOT the bare  # portable-paths-allow: placeholder example, not a real domain
# ".pages.dev" — Cloudflare Pages project names aren't namespaced per  # portable-paths-allow: placeholder example, not a real domain
# account, so a bare TLD-style suffix would trust every Pages project anyone
# else creates too. e.g. ALLOWED_ORIGIN_SUFFIXES=.<your-project>.pages.dev  # portable-paths-allow: placeholder example, not a real domain
# (Vercel's ".vercel.app" preview subdomains have the same per-project
# scoping need if still on the paid path.)
ALLOWED_ORIGIN_SUFFIXES=

# Supabase (cloud project — create at supabase.com, same project used for local + prod)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only used by `supabase db push` to apply migrations non-interactively
# (see supabase/README.md). Not needed by the app or ingest runtime.
SUPABASE_DB_PASSWORD=

# LLM — Anthropic for evaluation/structuring/vision; OpenAI for embeddings
# (text-embedding-3-small, 1536-dim — see src/lib/embeddings.ts).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Auth: the API verifies each request's Supabase JWT against the project's JWKS
# endpoint, derived from SUPABASE_URL above — no extra config needed. (The
# DEV_USER_ID stand-in was removed when real Supabase Auth landed.)

# Review Queue access is gated by the users_profile.is_admin flag (migration
# 0054), not an env var — no ADMIN_MODE setting anymore. Seed an admin via SQL
# (update users_profile set is_admin=true where id=<auth uid>).

# Nightly qgen top-up cost ceiling (USD) for `pnpm qgen:topup` (Message Batches,
# 0.5x). The job trims shortfall nodes to fit and defers the rest. Default 5.
QGEN_BATCH_MAX_USD=5

# Guest (anonymous) account retention. nightly:settle prunes anonymous users
# that are BOTH older than this many days AND inactive that whole window
# (users_profile.last_active_date). Default 30. Converted/real accounts are
# never touched. Manual: pnpm --filter api guests:prune [--apply] [--days N].
GUEST_RETENTION_DAYS=30

# In-process current-affairs scheduler (apps/api/src/ca/scheduler.ts). OFF unless
# set to 1/true. When on, a running `pnpm dev` re-runs the CA pipeline every 6h
# (IST) and the weekly assembly on Mondays, from inside the API process.
#
# It is opt-in because "dev-only" describes the PROCESS, not the DATA: dev and
# production share ONE Supabase project (CLAUDE.md → Architecture), so every row
# it writes is a production row and every LLM call is real money — an idle
# `pnpm dev` left open overnight would publish content unattended. Leave it unset
# and run `pnpm ca:run` by hand when you want a fresh local feed; scheduled
# production runs come from .github/workflows/ca-run.yml, not from any dev box.
CA_DEV_SCHEDULER=

# In-process daily scheduler (apps/api/src/daily/scheduler.ts). OFF unless set to
# 1/true. When on, a running `pnpm dev` builds the daily quiz + answer set at
# 05:00 IST, settles streaks/Perfect Day/mastery/mentor insights at 00:05 IST,
# and HOURLY generates notification nudges and sends real web push.
#
# Opt-in for the same reason as CA_DEV_SCHEDULER above, plus one worse: dev and
# production share ONE Supabase project (CLAUDE.md → Architecture), so every row
# it writes is a production row — and the hourly job pushes notifications to real
# users' devices from whatever laptop the process is on. Leave it unset and run
# the jobs by hand (`pnpm daily:build`, `pnpm --filter api nightly:settle`,
# `pnpm --filter api notifications:run`); scheduled production runs come from
# .github/workflows/daily-build.yml, nightly-settle.yml and notifications.yml.
DAILY_DEV_SCHEDULER=

# Billing — Razorpay. Create keys at dashboard.razorpay.com (Settings → API
# Keys); test keys are rzp_test_*, live keys rzp_live_*. The webhook secret is
# set when you add a webhook endpoint (Settings → Webhooks) pointing at
# POST /api/v1/billing/webhook; it must match RAZORPAY_WEBHOOK_SECRET here AND
# belong to the SAME mode as the key id (test vs live webhooks are configured
# separately in the dashboard). KEY_ID is browser-safe (returned to checkout.js
# by /billing/order); the SECRET and WEBHOOK_SECRET are server-only.
#
# Mode is derived from the KEY_ID prefix (rzp_test_ = test, rzp_live_ = live)
# and logged at boot + shown to admins on GET /admin/status — never silent.
# Optionally set RAZORPAY_MODE=test|live to DECLARE the intended mode: the API
# then refuses to transact (500) if it disagrees with the key prefix, so a
# leftover test key on a live deploy (or vice versa) fails loudly instead of
# quietly charging in the wrong mode. Leave unset to skip the assertion.
RAZORPAY_MODE=
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Web push (VAPID). Generate a pair with `npx web-push generate-vapid-keys`.
# PUBLIC_KEY must exactly match apps/web/.env.local's VITE_VAPID_PUBLIC_KEY —
# the browser signs its subscription against the public key, and the server
# signs the push payload with the private key; a mismatch fails silently as a
# 401 from the push service, not a helpful error.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: Sentry error tracking (server). No DSN = Sentry is a no-op.
SENTRY_DSN=
